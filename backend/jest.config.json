{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "setupFilesAfterEnv": ["<rootDir>/tests/setup.ts"],
  "testMatch": ["**/tests/**/*.test.ts"],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "coveragePathIgnorePatterns": [
    "/node_modules/",
    "/tests/",
    "/src/config/",
    "/src/types/"
  ],
  "verbose": true,
  "maxWorkers": 1,
  "testTimeout": 30000,
  "globals": {
    "ts-jest": {
      "tsconfig": "tsconfig.json"
    }
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.d.ts",
    "!src/index.ts"
  ],
  "coverageDirectory": "coverage",
  "coverageReporters": ["text", "lcov", "html"]
}